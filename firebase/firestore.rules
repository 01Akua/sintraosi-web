rules_version = '2';

// Reglas de acceso a la base de afiliados de SINTRAOSI.
//
// Modelo: solo usuarios autenticados con Firebase Auth (email/contraseña) pueden
// leer o escribir. Las cuentas de Auth se crean manualmente en la consola de
// Firebase (Authentication -> Add user), NO hay registro público. Además, cada
// usuario autenticado debe tener un documento admins/{email en minúsculas} para
// poder operar -> así una cuenta de Auth sin admin asociado no tiene acceso.
// Se usa el email (no el UID) como ID del documento admin para que un admin
// existente pueda dar de alta a otro desde el propio panel sin necesitar el UID.
service cloud.firestore {
  match /databases/{database}/documents {

    function esAdmin() {
      return request.auth != null &&
        request.auth.token.email != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()));
    }

    match /afiliados/{cedula} {
      allow read: if esAdmin();
      allow create: if esAdmin() &&
        request.resource.data.cedula == cedula &&
        request.resource.data.canal_registro in ['presencial', 'web'] &&
        request.resource.data.estado in ['activo', 'pendiente_verificacion'];
      allow update: if esAdmin();
      allow delete: if esAdmin();
    }

    // admins/{email en minúsculas}: { email, nombre, rol, creado_en, creado_por }
    // Un admin existente da de alta el email de un nuevo admin (allow create);
    // eso es solo la "autorización" -- la cuenta de login (Firebase Auth) se la
    // crea la propia persona autorizada desde la pantalla de login, sin tocar
    // la consola de Firebase.
    //
    // "get" (leer UN documento puntual) es público: así la pantalla de "crear
    // mi cuenta" puede confirmar "sí, mi correo fue autorizado" antes de dejar
    // crear la contraseña, sin exponer la lista completa de admins a cualquiera.
    // "list" (la colección completa) sigue siendo solo para admins.
    match /admins/{email} {
      allow get: if true;
      allow list: if esAdmin();
      allow create, update: if esAdmin();
      allow delete: if esAdmin() && email != request.auth.token.email.lower();
    }

    // Bitácora simple de cambios (opcional, se escribe desde el panel).
    match /auditoria/{entryId} {
      allow read: if esAdmin();
      allow create: if esAdmin();
      allow update, delete: if false;
    }

    // ---- Contenido editable del sitio público (CMS) ----

    // noticias/{id}: artículo con estado 'borrador' o 'publicado'. El sitio
    // público solo puede leer los publicados; el panel (autenticado) ve todo.
    match /noticias/{id} {
      allow read: if resource.data.estado == 'publicado' || esAdmin();
      allow write: if esAdmin();
    }

    // paginas_borrador/{pageId}: copia de trabajo de los textos/listas de una
    // página (solo el panel la lee y edita).
    match /paginas_borrador/{pageId} {
      allow read, write: if esAdmin();
    }

    // paginas_publicado/{pageId}: lo que el sitio público realmente muestra.
    // Lectura abierta a cualquiera (es contenido público del sitio); solo un
    // admin puede escribir, y solo lo hace vía el botón "Publicar" del panel.
    match /paginas_publicado/{pageId} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // ---- Votaciones (asamblea y elecciones) ----
    //
    // Los afiliados NO tienen cuenta de Firebase Auth, así que la identidad y el
    // "un voto por persona" se garantizan sin backend, solo con estas reglas:
    //
    // 1. votantes_hash/{hash}: hash = sha256(cedula + "|" + fecha_nacimiento).
    //    El panel (o el script de sincronización) crea un doc vacío por cada
    //    afiliado activo -> el hash en sí no revela la cédula ni la fecha.
    // 2. Para votar, el navegador del afiliado calcula el mismo hash a partir de
    //    lo que la persona escribió y solo puede crear un voto_registros/{id}
    //    si ese hash existe en votantes_hash (= es un afiliado activo real).
    // 3. voto_registros/{votacionId}__{hash}: el ID del documento combina
    //    votación + hash. Firestore trata un segundo intento de escribir el
    //    mismo ID como "update", no "create" -> como update/delete están
    //    bloqueados, es estructuralmente imposible votar dos veces con el
    //    mismo hash en la misma votación.
    // 4. voto_respuestas/{autoId}: el voto real (qué opción eligió). No tiene
    //    ningún campo que lo conecte con voto_registros ni con la persona ->
    //    voto secreto. Solo un admin puede leer las respuestas mientras la
    //    votación está abierta; si el creador marcó "resultados públicos",
    //    cualquiera puede leerlas una vez cerrada.

    match /votaciones/{votacionId} {
      allow read: if esAdmin() || resource.data.estado in ['abierta', 'cerrada'];
      allow create, delete: if esAdmin();
      // El voto público solo puede tocar el contador `participantes` (vía
      // increment() atómico) mientras la votación está abierta -> no puede
      // cambiar título, preguntas, estado ni nada más.
      allow update: if esAdmin() || (
        resource.data.estado == 'abierta' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantes'])
      );
    }

    match /votantes_hash/{hash} {
      // Lectura pública: el hash no es reversible a la cédula, solo sirve para
      // que el propio afiliado confirme "sí estoy habilitado" antes de votar.
      allow read: if true;
      allow write: if esAdmin();
    }

    match /voto_registros/{regId} {
      allow read: if esAdmin();
      allow create: if exists(/databases/$(database)/documents/votantes_hash/$(regId.split('__')[1])) &&
        get(/databases/$(database)/documents/votaciones/$(regId.split('__')[0])).data.estado == 'abierta';
      allow update, delete: if false;
    }

    match /voto_respuestas/{respId} {
      allow read: if esAdmin() ||
        get(/databases/$(database)/documents/votaciones/$(resource.data.votacion_id)).data.estado == 'cerrada' &&
        get(/databases/$(database)/documents/votaciones/$(resource.data.votacion_id)).data.resultados_publicos == true;
      allow create: if get(/databases/$(database)/documents/votaciones/$(request.resource.data.votacion_id)).data.estado == 'abierta';
      allow update, delete: if false;
    }
  }
}
